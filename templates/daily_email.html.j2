{% macro ai_disclaimer_chip() -%}
<span style="display:inline-block;padding:5px 10px;border:1px solid rgba(243,186,47,0.35);border-radius:999px;background:rgba(243,186,47,0.08);color:#f3ba2f;font-size:10px;font-weight:700;letter-spacing:0.10em;text-transform:uppercase;">🤖 AI-generated · not investment advice</span>
{%- endmacro %}
{% macro section_header(label, accent='#f3ba2f') -%}
<table role="presentation" cellspacing="0" cellpadding="0" width="100%" style="margin-bottom:18px;">
  <tr>
    <td style="white-space:nowrap;padding-right:14px;color:{{ accent }};font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;">{{ label }}</td>
    <td style="width:100%;height:1px;background:linear-gradient(90deg, rgba(243,186,47,0.30) 0%, rgba(29,39,64,0.85) 35%, rgba(29,39,64,0.85) 100%);line-height:1px;font-size:0;">&nbsp;</td>
  </tr>
</table>
{%- endmacro %}
{% macro signed_arrow(value) -%}
{% if (value|string).startswith('-') or (value|string).startswith('€-') %}▼{% elif (value|string).startswith('+') or (value|string).startswith('€+') %}▲{% else %}·{% endif %}
{%- endmacro %}
{% macro metric_tile(label, value, sub=None, sign='neutral') -%}
{% set color = '#0ecb81' if sign == 'pos' else ('#f6465d' if sign == 'neg' else '#ffffff') %}
{% set arrow = '▲' if sign == 'pos' else ('▼' if sign == 'neg' else '') %}
<div class="metric" style="padding:18px 20px;">
  <div class="eyebrow">{{ label }}</div>
  <p class="metric-value num" style="color:{{ color }};">{% if arrow %}<span style="font-size:14px;vertical-align:2px;margin-right:4px;">{{ arrow }}</span>{% endif %}{{ value }}</p>
  {% if sub %}<div class="muted num" style="margin-top:4px;font-size:12px;">{{ sub }}</div>{% endif %}
</div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #0b0f19;
        color: #e6edf7;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .num {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
      }
      a {
        color: #f3ba2f;
        text-decoration: none;
      }
      .shell {
        width: 100%;
        background-color: #0d1320;
        background:
          radial-gradient(circle at 92% 6%, rgba(243, 186, 47, 0.10), transparent 32%),
          radial-gradient(circle at 5% 85%, rgba(14, 203, 129, 0.05), transparent 38%),
          linear-gradient(180deg, #0d1320 0%, #0b0f19 100%);
      }
      .container {
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: 28px 16px 44px;
      }
      .panel {
        background: #131a2a;
        border: 1px solid #1f2944;
        border-radius: 18px;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
      }
      .section {
        margin-top: 20px;
        padding: 24px;
      }
      .eyebrow {
        color: #8b9bb8;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .title {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: 34px;
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -0.018em;
      }
      .subtitle {
        margin: 0;
        color: #b7c2d9;
        font-size: 15px;
        line-height: 1.6;
      }
      .score-grid,
      .card-grid,
      .theme-grid,
      .macro-grid {
        width: 100%;
      }
      .metric,
      .mini-card {
        background: linear-gradient(180deg, #131c30 0%, #0f1524 100%);
        border: 1px solid #1f2944;
        border-radius: 14px;
      }
      .metric-value {
        margin: 6px 0 0;
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .muted {
        color: #91a0bb;
      }
      .table {
        width: 100%;
        border-collapse: collapse;
      }
      .table th,
      .table td {
        padding: 13px 10px;
        border-bottom: 1px solid #1d2740;
        text-align: left;
        font-size: 13px;
        vertical-align: middle;
      }
      .table th {
        color: #8b9bb8;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-bottom: 1px solid #222c42;
        background: rgba(243, 186, 47, 0.025);
      }
      .table tr:last-child td {
        border-bottom: 0;
      }
      .ticker-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 8px;
        background: rgba(243, 186, 47, 0.08);
        border: 1px solid rgba(243, 186, 47, 0.25);
        color: #f3ba2f;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.04em;
        font-variant-numeric: tabular-nums;
      }
      .cell-mono {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
      }
      .theme-wrap {
        margin-top: 18px;
        padding: 22px;
        background: linear-gradient(180deg, #111827 0%, #0d1320 100%);
        border: 1px solid #1d2740;
        border-radius: 16px;
      }
      .article-card {
        margin-top: 10px;
        padding: 14px 16px;
        background: #0f1524;
        border: 1px solid #1d2740;
        border-radius: 12px;
      }
      .flash-block {
        margin-top: 16px;
        padding: 16px 18px;
        border: 1px solid rgba(243, 186, 47, 0.25);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(243, 186, 47, 0.10) 0%, rgba(243, 186, 47, 0.03) 100%);
      }
      .copy p {
        margin: 0 0 14px;
        color: #d5deed;
        font-size: 14px;
        line-height: 1.7;
      }
      .copy-longform p {
        font-size: 15px !important;
        line-height: 1.8 !important;
        color: #e6edf7 !important;
        margin-bottom: 18px !important;
      }
      .copy-longform p:first-of-type {
        font-size: 16px !important;
        color: #ffffff !important;
      }
      .footer-note {
        color: #8b9bb8;
        font-size: 12px;
        line-height: 1.6;
      }
      .hero-body {
        position: relative;
        padding: 36px 32px 32px;
        background-color: #131a2a;
        background:
          radial-gradient(circle at 95% 20%, rgba(243, 186, 47, 0.13), transparent 42%),
          linear-gradient(180deg, #131a2a 0%, #101626 100%);
      }
      .brand-mark {
        background: #11141e;
        border: 1px solid #1f2944;
        border-radius: 12px;
        padding: 10px 14px;
        line-height: 0;
      }
      .panel-divider {
        height: 1px;
        line-height: 1px;
        font-size: 0;
        margin: 22px 0 -2px;
        background: linear-gradient(90deg, rgba(243, 186, 47, 0) 0%, rgba(243, 186, 47, 0.35) 50%, rgba(243, 186, 47, 0) 100%);
      }
      @media only screen and (max-width: 640px) {
        .container {
          padding: 16px 10px 28px;
        }
        .section {
          padding: 18px 16px;
        }
        .hero-body {
          padding: 26px 18px 24px !important;
        }
        .title {
          font-size: 26px !important;
        }
        .metric-value {
          font-size: 22px !important;
        }
        .table th,
        .table td {
          padding-left: 6px;
          padding-right: 6px;
        }
        .card-grid td,
        .macro-grid td,
        .score-grid td {
          display: block !important;
          width: 100% !important;
          padding: 6px 0 !important;
        }
        .score-grid {
          border-spacing: 0 !important;
          margin: 0 !important;
        }
        .conc-paths {
          display: none !important;
        }
        .hero-mast-date {
          display: none !important;
        }
        .hero-mast-logo {
          padding: 14px 16px !important;
        }
        .hero-mast-logo img {
          width: 112px !important;
          max-width: 112px !important;
        }
      }
    </style>
  </head>
  <body>
    <div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#0b0f19;opacity:0;">
      {{ subtitle }} · Daily PnL {{ total_pnl.daily_pnl_eur }} · {{ position_rows|length }} positions tracked.
    </div>
    <div class="shell">
      <div class="container">
        <section class="panel" data-section="hero" style="padding:0;overflow:hidden;">
          <table role="presentation" cellspacing="0" cellpadding="0" width="100%" style="background:#0b0f19;border-collapse:collapse;">
            <tr>
              <td class="hero-mast-logo" align="left" valign="middle" style="padding:16px 22px;vertical-align:middle;">
                <span class="brand-mark" style="display:inline-block;background:#11141e;border:1px solid #1f2944;border-radius:12px;padding:8px 12px;line-height:0;">
                  <img src="{{ logo_data_uri }}" alt="Portfolio Radar" width="140" style="display:block;width:140px;max-width:140px;height:auto;border:0;" />
                </span>
              </td>
              <td class="hero-mast-date" align="right" valign="middle" style="padding:16px 22px;text-align:right;vertical-align:middle;color:#f3ba2f;font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
                <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#f3ba2f;margin-right:8px;vertical-align:1px;"></span>{{ generated_for_date }}
              </td>
            </tr>
          </table>
          <div style="height:1px;line-height:1px;font-size:0;background:linear-gradient(90deg, rgba(243,186,47,0) 0%, rgba(243,186,47,0.55) 50%, rgba(243,186,47,0) 100%);">&nbsp;</div>
          <div class="hero-body">
            <div class="eyebrow" style="margin-bottom:14px;color:#f3ba2f;">Portfolio Radar · {{ mode_label }} edition</div>
            <h1 class="title">{{ title }}</h1>
            <p class="subtitle" style="margin-top:10px;">{{ subtitle }}</p>
            {% block hero_chip %}
            <table role="presentation" cellspacing="0" cellpadding="0" style="margin-top:22px;">
              <tr>
                <td style="padding-right:8px;">
                  <span style="display:inline-block;padding:6px 14px;background:rgba(243,186,47,0.12);border:1px solid rgba(243,186,47,0.35);border-radius:999px;color:#f3ba2f;font-size:11px;font-weight:700;letter-spacing:0.10em;text-transform:uppercase;">{{ mode_label }}</span>
                </td>
                <td style="padding-right:8px;">
                  <span style="display:inline-block;padding:6px 14px;background:#0f1524;border:1px solid #1f2944;border-radius:999px;color:#b7c2d9;font-size:11px;font-weight:600;letter-spacing:0.06em;">Tracking {{ position_rows|length }} positions</span>
                </td>
              </tr>
            </table>
            {% endblock %}
          </div>
        </section>

        {% block deep_lede %}{% endblock %}

        <section class="panel section" data-section="pnl-scoreboard">
          {{ section_header("PnL Scoreboard") }}
          {% set total_pnl_sign = 'neg' if total_pnl.total_pnl_eur.startswith('-') or total_pnl.total_pnl_eur.startswith('€-') else ('pos' if total_pnl.total_pnl_eur.startswith('+') or total_pnl.total_pnl_eur.startswith('€+') else 'neutral') %}
          {% set daily_pnl_sign = 'neg' if total_pnl.daily_pnl_eur.startswith('-') or total_pnl.daily_pnl_eur.startswith('€-') else ('pos' if total_pnl.daily_pnl_eur.startswith('+') or total_pnl.daily_pnl_eur.startswith('€+') else 'neutral') %}

          <div style="padding:22px 24px;background:linear-gradient(135deg, rgba(243,186,47,0.08) 0%, rgba(15,21,36,0.0) 60%), linear-gradient(180deg,#131c30 0%,#0f1524 100%);border:1px solid #1f2944;border-radius:16px;">
            <div class="eyebrow" style="color:#f3ba2f;">Current portfolio value</div>
            <p class="num" style="margin:8px 0 0;color:#ffffff;font-size:38px;font-weight:800;letter-spacing:-0.02em;line-height:1.05;">{{ total_pnl.current_value_total_eur }}</p>
            <div class="muted" style="margin-top:6px;font-size:12px;">As of {{ generated_for_date }} · {{ position_rows|length }} tracked tickers</div>
          </div>

          <table class="score-grid" role="presentation" cellspacing="0" cellpadding="0" width="100%" style="border-collapse:separate;border-spacing:10px;margin:6px -10px 0;">
            <tr>
              <td style="width:33.33%;">
                {{ metric_tile('Total PnL', total_pnl.total_pnl_eur, sub=total_pnl.total_pnl_pct, sign=total_pnl_sign) }}
              </td>
              <td style="width:33.33%;">
                {{ metric_tile('Daily PnL', total_pnl.daily_pnl_eur, sign=daily_pnl_sign) }}
              </td>
              <td style="width:33.33%;">
                {{ metric_tile('Tracked Positions', position_rows|length|string) }}
              </td>
            </tr>
          </table>

          <table class="table" cellspacing="0" cellpadding="0" style="margin-top:20px;">
            <thead>
              <tr>
                <th>Ticker</th>
                <th>Theme</th>
                <th style="text-align:right;">Value</th>
                <th style="text-align:right;">Total PnL</th>
                <th style="text-align:right;">Daily</th>
              </tr>
            </thead>
            <tbody>
              {% for row in position_rows %}
              <tr{% if loop.index is even %} style="background:rgba(255,255,255,0.012);"{% endif %}>
                <td><span class="ticker-pill">{{ row.ticker }}</span></td>
                <td class="muted" style="font-size:12px;">{{ row.theme }}</td>
                <td class="cell-mono num" style="text-align:right;color:#ffffff;font-weight:600;">{{ row.current_value_eur }}</td>
                <td class="cell-mono num" style="text-align:right;font-weight:600;color:{% if row.total_pnl_pct.startswith('-') %}#f6465d{% elif row.total_pnl_pct.startswith('+') and row.total_pnl_pct != '+0.0%' %}#0ecb81{% else %}#8b9bb8{% endif %};">{{ row.total_pnl_pct }}</td>
                <td class="cell-mono num" style="text-align:right;font-weight:600;color:{% if row.daily_change_pct.startswith('-') %}#f6465d{% elif row.daily_change_pct.startswith('+') and row.daily_change_pct != '+0.0%' %}#0ecb81{% else %}#8b9bb8{% endif %};">{{ row.daily_change_pct }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </section>

        <section class="panel section" data-section="concentrated-exposures">
          {{ section_header("Concentrated Exposures") }}
          <table role="presentation" cellspacing="0" cellpadding="0" width="100%">
            {% for row in concentrated_exposures %}
            {% set raw = row.composite_weight_percent.lstrip('+').rstrip('%') %}
            {% set pct = raw|float %}
            {% set bar_width = ([pct, 30.0]|min / 30.0 * 100)|round(1) %}
            <tr>
              <td style="padding:14px 0;{% if not loop.last %}border-bottom:1px solid #1d2740;{% endif %}">
                <table role="presentation" cellspacing="0" cellpadding="0" width="100%">
                  <tr>
                    <td style="width:96px;color:#f3ba2f;font-weight:800;font-size:14px;letter-spacing:0.02em;font-variant-numeric:tabular-nums;">{{ row.entity }}</td>
                    <td style="padding:0 14px;">
                      <div style="height:10px;background:#0b0f19;border:1px solid #1d2740;border-radius:999px;overflow:hidden;box-shadow:inset 0 1px 2px rgba(0,0,0,0.4);">
                        <div bgcolor="#f3ba2f" style="width:{{ bar_width }}%;height:10px;background:linear-gradient(90deg, #f3ba2f 0%, #f6c85a 60%, #fde08c 100%);border-radius:999px;"></div>
                      </div>
                    </td>
                    <td class="num" style="width:88px;text-align:right;color:#ffffff;font-weight:700;font-size:15px;letter-spacing:-0.01em;">{{ row.composite_weight_percent }}</td>
                    <td class="muted num conc-paths" style="width:80px;text-align:right;font-size:11px;letter-spacing:0.04em;">{{ row.path_count }} path{% if row.path_count != 1 %}s{% endif %}</td>
                  </tr>
                </table>
              </td>
            </tr>
            {% endfor %}
          </table>
        </section>

        <section class="panel section" data-section="theme-groups">
          {{ section_header("Theme Groups") }}
          {% for group in theme_groups %}
          <div class="theme-wrap">
            <table role="presentation" cellspacing="0" cellpadding="0" width="100%">
              <tr>
                <td style="width:3px;background:#f3ba2f;border-radius:2px;">&nbsp;</td>
                <td style="padding-left:14px;">
                  <h2 style="margin:0;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.012em;">{{ group.name }}</h2>
                  <p style="margin:6px 0 0;color:#aebbd2;font-size:13px;line-height:1.55;">{{ group.description }}</p>
                </td>
              </tr>
            </table>

            <table class="card-grid" role="presentation" cellspacing="0" cellpadding="0" width="100%" style="margin-top:16px;border-collapse:separate;border-spacing:8px;margin-left:-8px;margin-right:-8px;">
              {% set card_rows = group.cards|batch(3) %}
              {% for chunk in card_rows %}
              <tr>
                {% for card in chunk %}
                <td style="width:33.33%;vertical-align:top;">
                  <div class="mini-card" style="padding:14px 16px;">
                    <div style="display:inline-block;padding:3px 8px;background:rgba(243,186,47,0.08);border:1px solid rgba(243,186,47,0.25);border-radius:6px;color:#f3ba2f;font-weight:700;font-size:11px;letter-spacing:0.06em;font-variant-numeric:tabular-nums;">{{ card.ticker }}</div>
                    <div class="num" style="margin-top:10px;color:#ffffff;font-size:19px;font-weight:700;letter-spacing:-0.01em;">{{ card.current_value_eur }}</div>
                    <table role="presentation" cellspacing="0" cellpadding="0" width="100%" style="margin-top:10px;">
                      <tr>
                        <td class="muted" style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;">Total</td>
                        <td class="num" style="text-align:right;font-size:13px;font-weight:600;color:{% if card.total_pnl_pct.startswith('-') %}#f6465d{% elif card.total_pnl_pct == '+0.0%' %}#8b9bb8{% else %}#0ecb81{% endif %};">{{ card.total_pnl_pct }}</td>
                      </tr>
                      <tr>
                        <td class="muted" style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;padding-top:4px;">Daily</td>
                        <td class="num" style="text-align:right;font-size:13px;font-weight:600;padding-top:4px;color:{% if card.daily_change_pct.startswith('-') %}#f6465d{% elif card.daily_change_pct == '+0.0%' %}#8b9bb8{% else %}#0ecb81{% endif %};">{{ card.daily_change_pct }}</td>
                      </tr>
                    </table>
                  </div>
                </td>
                {% endfor %}
                {% for _ in range(3 - (chunk|length)) %}
                <td style="width:33.33%;"></td>
                {% endfor %}
              </tr>
              {% endfor %}
            </table>

            {% if group.flash_text %}
            <div class="flash-block">
              {{ ai_disclaimer_chip() }}
              <p style="margin:12px 0 0;color:#f4f7fb;font-size:14px;line-height:1.7;">{{ group.flash_text }}</p>
            </div>
            {% endif %}

            {% for article in group.articles %}
            <div class="article-card news-item">
              <table role="presentation" cellspacing="0" cellpadding="0" width="100%">
                <tr>
                  <td>
                    <span style="display:inline-block;padding:3px 8px;background:#1a2335;border:1px solid #2a3856;border-radius:6px;color:#b7c2d9;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">{{ article.source }}</span>
                    <span class="muted" style="margin-left:8px;font-size:11px;letter-spacing:0.04em;">{{ article.published_at_label }}</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding-top:8px;">
                    <a href="{{ article.href }}" style="color:#ffffff;text-decoration:none;font-size:15px;line-height:1.45;font-weight:600;letter-spacing:-0.005em;">{{ article.title }}</a>
                  </td>
                </tr>
                <tr>
                  <td style="padding-top:8px;">
                    <span style="display:inline-block;padding:3px 8px;background:rgba(243,186,47,0.08);border:1px solid rgba(243,186,47,0.25);border-radius:6px;color:#f3ba2f;font-weight:700;font-size:10px;letter-spacing:0.06em;font-variant-numeric:tabular-nums;">{{ article.primary_entity }}</span>
                    <span class="num muted" style="margin-left:8px;font-size:11px;">{{ article.composite_weight_percent }}</span>
                    {% if article.affects_themes %}
                    <span style="margin-left:8px;color:#52617f;">·</span>
                    {% for theme in article.affects_themes %}
                    <span class="muted" style="margin-left:6px;font-size:11px;">{{ theme }}{% if not loop.last %},{% endif %}</span>
                    {% endfor %}
                    {% endif %}
                  </td>
                </tr>
              </table>
            </div>
            {% endfor %}
          </div>
          {% endfor %}
        </section>

        {% if synthesis_paragraphs %}
        <section class="panel section" data-section="ai-synthesis">
          {{ section_header("AI Synthesis") }}
          {% block synthesis_intro %}{% endblock %}
          <div style="margin-top:14px;">{{ ai_disclaimer_chip() }}</div>
          <div class="copy {% block synthesis_class %}{% endblock %}" style="margin-top:16px;">
            {% block synthesis_copy %}
            {% for paragraph in synthesis_paragraphs %}
            <p>{{ paragraph }}</p>
            {% endfor %}
            {% endblock %}
          </div>
        </section>
        {% endif %}
        {% block week_ahead %}{% endblock %}

        <section class="panel section" data-section="macro-footer" style="padding:24px;">
          {{ section_header("Macro & Markets") }}
          {% if macro_items %}
          <table class="macro-grid" role="presentation" cellspacing="0" cellpadding="0" width="100%" style="border-collapse:separate;border-spacing:8px;margin:0 -8px;">
            {% set macro_rows = macro_items|batch(2) %}
            {% for chunk in macro_rows %}
            <tr>
              {% for item in chunk %}
              <td style="width:50%;vertical-align:top;">
                <div style="padding:14px 16px;background:linear-gradient(180deg,#131c30 0%,#0f1524 100%);border:1px solid #1f2944;border-radius:12px;">
                  <div>
                    <span style="display:inline-block;padding:3px 8px;background:#1a2335;border:1px solid #2a3856;border-radius:6px;color:#b7c2d9;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">{{ item.source }}</span>
                    <span class="muted" style="margin-left:8px;font-size:11px;letter-spacing:0.04em;">{{ item.published_at_label }}</span>
                  </div>
                  <a href="{{ item.href }}" style="display:block;margin-top:10px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;line-height:1.45;letter-spacing:-0.005em;">{{ item.title }}</a>
                </div>
              </td>
              {% endfor %}
              {% for _ in range(2 - (chunk|length)) %}
              <td style="width:50%;"></td>
              {% endfor %}
            </tr>
            {% endfor %}
          </table>
          {% else %}
          <p class="footer-note" style="margin:12px 0 0;">No fresh macro items cleared the last 24h window.</p>
          {% endif %}
        </section>

        <div class="panel-divider">&nbsp;</div>
        <p class="footer-note" style="margin:18px 4px 0;text-align:center;">
          Andy &amp; Juan Radar · Generated for {{ generated_for_date }}<br/>
          Review source links before acting on any market-moving information.
        </p>
      </div>
    </div>
  </body>
</html>
